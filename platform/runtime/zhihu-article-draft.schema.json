{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["title_options", "title", "body", "tags", "image_prompts", "creative_note"],
  "properties": {
    "title_options": { "type": "array", "minItems": 3, "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
    "title": { "type": "string", "minLength": 1, "maxLength": 100 },
    "body": { "type": "string", "minLength": 100, "maxLength": 20000 },
    "tags": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 32 } },
    "image_prompts": { "type": "array", "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["label", "prompt"], "properties": { "label": { "type": "string", "maxLength": 30 }, "prompt": { "type": "string", "maxLength": 1600 } } } },
    "creative_note": { "type": "string", "maxLength": 500 }
  }
}
