{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "core_claims", "logic_chain", "fact_anchors", "expression_hooks", "risks"],
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "core_claims": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "logic_chain": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "fact_anchors": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "expression_hooks": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "risks": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  }
}
