{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["overview", "sample_analyses", "topics"],
  "properties": {
    "overview": { "type": "string" },
    "sample_analyses": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["feed_id", "summary", "hook_points", "title_hook", "visual_highlight", "pain_point", "practical_value", "controversy_point", "content_structure", "reusable_directions", "account_adaptation", "is_relevant", "relevance_score", "information_density_score", "remix_value_score", "account_fit_score", "visible_proof_score", "reproducibility_score", "selection_reason"],
        "properties": {
          "feed_id": { "type": "string" },
          "summary": { "type": "string" },
          "hook_points": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string" } },
          "title_hook": { "type": "string" },
          "visual_highlight": { "type": "string" },
          "pain_point": { "type": "string" },
          "practical_value": { "type": "string" },
          "controversy_point": { "type": "string" },
          "content_structure": { "type": "array", "minItems": 1, "maxItems": 7, "items": { "type": "string" } },
          "reusable_directions": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string" } },
          "account_adaptation": { "type": "string" },
          "is_relevant": { "type": "boolean" },
          "relevance_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "information_density_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "remix_value_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "account_fit_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "visible_proof_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "reproducibility_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "selection_reason": { "type": "string" }
        }
      }
    },
    "topics": {
      "type": "array", "minItems": 3, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "brief", "target_audience", "pain_point", "hook_points", "content_structure", "why_it_works", "account_fit", "source_feed_ids", "score"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "brief": { "type": "string" },
          "target_audience": { "type": "string" },
          "pain_point": { "type": "string" },
          "hook_points": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string" } },
          "content_structure": { "type": "array", "minItems": 3, "maxItems": 7, "items": { "type": "string" } },
          "why_it_works": { "type": "string" },
          "account_fit": { "type": "string" },
          "source_feed_ids": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "type": "string" } },
          "score": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      }
    }
  }
}
