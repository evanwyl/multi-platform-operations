{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["title_options", "title", "body", "tags", "image_prompts", "creative_note"],
  "properties": {
    "title_options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 1, "maxLength": 20 }
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 20 },
    "body": { "type": "string", "minLength": 20, "maxLength": 1200 },
    "tags": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 16 }
    },
    "image_prompts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "prompt"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 20 },
          "prompt": { "type": "string", "minLength": 30, "maxLength": 1200 }
        }
      }
    },
    "creative_note": { "type": "string", "maxLength": 300 }
  }
}
